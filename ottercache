#!/usr/bin/env bash
# =============================================================================
# ottercache  –  Back up Lutris scripts & resources for GOG games
#
# Prerequisite: LGOGDownloader (tested with version 3.18.279b883)
#   https://github.com/Sude-/lgogdownloader.git
#
# Recommended download command to populate --gog-dir:
#
#   lgogdownloader \
#     --download \
#     --directory ~/GOG-Backup/ \
#     --platform all \
#     --language all \
#     --include all \
#     --retries 3 \
#     --threads 1 \
#     --report ~/GOG-Backup/download-report.log \
#     --check-free-space true \
#     --no-fast-status-check \
#     --automatic-xml-creation \
#     --xml-directory ~/GOG-Backup/lgogdownloader-gog-xml
#     --limit-rate 0 \
#     --save-serials \
#     --save-game-details-json \
#     --save-product-json \
#     --save-logo \
#     --save-icon \
#     --save-changelogs \
#     --include-hidden-products \
#     --progress-interval 1000
#
# Note: --save-product-json is required, as ottercache relies on the generated
# product_*.json files as its primary game detection source.
#
# Concurrency: ottercache acquires an exclusive flock on
# <output_dir>/reports/.ottercache.lock. Running a second instance against the
# same --output-dir will fail fast with an explanatory error. Use separate
# output directories for parallel runs.
#
# Required dependencies: bash 4+, curl, python3 (3.6+), PyYAML (python3-yaml),
# flock (util-linux), GNU coreutils. PyYAML is required even without
# --no-resources, because installer YAML generation now structures top-level
# fields (name, game_slug, version, slug, runner) per Lutris spec.
# =============================================================================
set -uo pipefail

# ── Constants ─────────────────────────────────────────────────────────────────
readonly LUTRIS_API="https://lutris.net/api"
readonly USER_AGENT="Mozilla/5.0 (X11; Linux x86_64)"
# Shared curl flag groups, referenced via "${CURL_BASE_OPTS[@]}" /
# "${CURL_REDIRECT_OPTS[@]}" by every curl-calling function below instead of
# each hand-repeating the same flags.
readonly -a CURL_BASE_OPTS=(--user-agent "$USER_AGENT")
readonly -a CURL_REDIRECT_OPTS=(--location --max-redirs 5)
readonly CURL_TIMEOUT=15
# DOWNLOAD_TIMEOUT is now just an outer safety net against pathological
# hangs (e.g. a connection that limps along at 1 byte every 59s forever) --
# the real stall detection is DOWNLOAD_MIN_SPEED/DOWNLOAD_STALL_TIME below.
# It used to be a hard 300s wall-clock cap on the *entire* transfer, which
# aborted large-but-healthy deeplink resources (multi-GB installers) well
# before they could finish, even though the same URL downloaded fine
# manually in a browser (no such cap there).
readonly DOWNLOAD_TIMEOUT=21600
readonly DOWNLOAD_MIN_SPEED=1024
readonly DOWNLOAD_STALL_TIME=60
readonly MAX_ATTEMPTS=3
readonly RETRY_BACKOFF_BASE=2
# Brief anti-hammering pause between successive outbound requests within a
# single game/installer's processing (distinct from --api-delay, which
# paces between whole games). REQUEST_PACING_DELAY covers actual Lutris API
# calls and real resource downloads; DRY_RUN_CHECK_PACING_DELAY is shorter
# since a dry-run status check is a much lighter request than either.
readonly REQUEST_PACING_DELAY=0.3
readonly DRY_RUN_CHECK_PACING_DELAY=0.2
# Shared by every find(1) scan over the GOG library / output tree: games
# live at most one level below --gog-dir, installer dirs one level below
# --output-dir.
readonly SCAN_MAXDEPTH=2

# ── Colours ───────────────────────────────────────────────────────────────────
readonly RED=$'\033[0;31m'   GREEN=$'\033[0;32m'  YELLOW=$'\033[1;33m'
readonly BLUE=$'\033[0;34m'  CYAN=$'\033[0;36m'   MAGENTA=$'\033[0;35m'
readonly BOLD=$'\033[1m'     DIM=$'\033[2m'        NC=$'\033[0m'

# ── Logging ───────────────────────────────────────────────────────────────────
log_info()    { echo -e "${BLUE}[INFO]${NC}     $*" >&2; }
log_ok()      { echo -e "${GREEN}[OK]${NC}       $*" >&2; }
log_warn()    { echo -e "${YELLOW}[WARN]${NC}     $*" >&2; }
log_error()   { echo -e "${RED}[ERROR]${NC}    $*" >&2; }
log_skip()    { echo -e "${DIM}[SKIP]${NC}     $*" >&2; }
log_dryrun()  { echo -e "${MAGENTA}[DRY-RUN]${NC}  $*" >&2; }

print_header() {
    echo -e "\n${BOLD}${CYAN}╔══════════════════════════════════════════════╗${NC}" >&2
    printf   "${BOLD}${CYAN}║  %-44s║${NC}\n" "$*" >&2
    echo -e   "${BOLD}${CYAN}╚══════════════════════════════════════════════╝${NC}" >&2
}
print_section() { echo -e "\n${BOLD}${MAGENTA}── $* ──${NC}" >&2; }

# ── Global state ──────────────────────────────────────────────────────────────
declare -A GAMES=()
declare -A SLUG_SEEN=()
declare -a BROKEN_LINKS=()
declare -a RESOURCE_ERRORS=()
declare -a SKIPPED_GAMES=()
declare -a DUPLICATE_SLUGS=()
declare -a SUCCESS_INSTALLERS=()
declare -a CACHED_INSTALLERS=()
declare -a PRUNED_DIRS=()
declare -a YAML_GENERATION_FAILURES=()
declare -i API_ERROR_COUNT=0

# SKIPPED_GAMES reason tags -- named so these 4 fixed bracket-tag strings
# written in process_game() aren't hand-retyped at each call site. A 5th
# reason ("[game detail HTTP $http_code]") stays an inline template at its
# one call site instead, since it interpolates a variable and so can't be a
# plain readonly string.
readonly SKIP_FULLY_CACHED='[fully cached, use --force to refresh]'
readonly SKIP_API_UNREACHABLE='[API unreachable]'
readonly SKIP_NOT_FOUND='[not found on lutris.net]'
readonly SKIP_NO_INSTALLERS='[no installers on lutris.net]'
declare -i HELPER_ERROR_COUNT=0

GOG_DIR=""
OUTPUT_DIR=""
DRY_RUN=false
FORCE=false
QUIET=false
NO_RESOURCES=false
PRUNE_OLD=false
PRUNE_ANYWAY=false
API_DELAY=1
TIMESTAMP=""
DIR_REPORTS=""
DIR_RUN=""
HELPER_PY=""
PY_ERROR_LOG=""
SLUG_CACHE_FILE=""
SLUG_OVERRIDES_FILE=""
LOCK_FILE=""
LOCK_FD=""
TOTAL=0

# ── Python helper script (written once at startup, all Python lives here) ────
_write_helper_python() {
    cat << 'PYEOF'
import json
import os
import re
import shutil
import sys
import urllib.parse


def err(msg):
    """Log to stderr and exit with a code reserved for genuine helper
    failures (bad args, unreadable/invalid input, missing dependency, ...).
    Exit codes 0/1 stay free for commands with a designed boolean-answer
    protocol (has_game_id, find_slug_in_results, verify_slug_match,
    cache_check) so a real error is never confused with a legitimate
    'false' answer."""
    print('PY_ERROR ' + sys.argv[1] + ': ' + msg, file=sys.stderr)
    sys.exit(2)


def warn(msg):
    """Log to stderr without exiting -- for non-fatal, caller-handled issues.
    Sibling to err(); use this instead of hand-rolling a 'PY_WARN <cmd>: ...'
    string at the call site."""
    print('PY_WARN ' + sys.argv[1] + ': ' + msg, file=sys.stderr)


def _require_argc(n):
    """Guard against a bash call-site arg-count bug surfacing as a raw
    Python IndexError traceback instead of a clean PY_ERROR line. n is the
    minimum total sys.argv length (script + command + positional args)."""
    if len(sys.argv) < n:
        err('expected at least {} argument(s), got {}'.format(
            n - 2, max(0, len(sys.argv) - 2)))


def _load_json(path):
    """Shared json.load-with-error-handling. Raises via err() (exits) on any
    read/parse failure -- callers only need to handle the success path.

    Not used by cmd_override_get, cmd_cache_get or cmd_cache_update: those
    three intentionally treat a missing file as "empty result", not an
    error (an override/cache file that hasn't been created yet is normal,
    first-run behavior), which is different from this function's
    unconditional fail-on-any-read-error contract."""
    try:
        with open(path) as f:
            return json.load(f)
    except Exception as e:
        err('cannot read ' + path + ': ' + str(e))


def _find_installer_by_slug(data, target_slug):
    """Returns the installer dict matching target_slug from an
    installers-list API response, or None if not present."""
    for inst in data.get('installers', []):
        if inst.get('slug') == target_slug:
            return inst
    return None


# Match-score threshold shared by cmd_find_slug_in_results (search-result
# fallback) and cmd_verify_slug_match (direct-slug acceptance) -- see
# cmd_verify_slug_match's docstring for how this was calibrated.
MATCH_THRESHOLD = 0.6

# Lutris installer spec's required top-level fields, per docs/installers.rst.
# Shared by cmd_save_installer_yaml (generates them) and cmd_localize_yaml
# (re-validates them survived the round-trip).
REQUIRED_TOP_LEVEL_FIELDS = ('name', 'game_slug', 'slug', 'runner')


# Shared by cmd_slug_candidates (slug generation), cmd_find_slug_in_results
# and cmd_verify_slug_match (fuzzy name matching) — GOG titles and Lutris
# names/slugs disagree on numerals ('Torchlight II' vs 'torchlight-2') often
# enough that both sides need the same normalization.
_ROMAN_TO_ARABIC = {
    'i': '1', 'ii': '2', 'iii': '3', 'iv': '4', 'v': '5', 'vi': '6',
    'vii': '7', 'viii': '8', 'ix': '9', 'x': '10', 'xi': '11', 'xii': '12',
    'xiii': '13', 'xiv': '14', 'xv': '15', 'xvi': '16', 'xvii': '17',
    'xviii': '18', 'xix': '19', 'xx': '20',
}
# Single-letter numerals (i, v, x) collide too easily with real words/
# initials inside a title ('X-COM', 'Ico') to safely rewrite when building a
# slug candidate — restrict the slug-generation swap to multi-letter
# numerals. The full dict (including single letters) is still used for
# token-overlap scoring below, where one stray token barely moves the score.
_ROMAN_SLUG_PATTERN = re.compile(
    r'\b(' + '|'.join(sorted((k for k in _ROMAN_TO_ARABIC if len(k) > 1),
                              key=len, reverse=True)) + r')\b',
    re.IGNORECASE,
)

# The reverse direction (GOG title has an arabic sequel number, Lutris slug
# uses roman numerals instead, e.g. 'Rebel Assault 2' -> 'rebel-assault-ii').
# Digits carry no letter-collision risk the way single-letter romans do, so
# the full 1-20 range is safe to include here (unlike _ROMAN_SLUG_PATTERN).
_ARABIC_TO_ROMAN = {v: k for k, v in _ROMAN_TO_ARABIC.items()}
_ARABIC_SLUG_PATTERN = re.compile(
    r'\b(' + '|'.join(sorted(_ARABIC_TO_ROMAN, key=len, reverse=True)) + r')\b'
)

# Common release-descriptor words GOG includes in the product title but
# Lutris slugs/names usually omit (e.g. 'Foo: Definitive Edition' -> 'foo',
# 'XIII Remake' -> 'XIII'). Shared by _EDITION_SUFFIX_RE (candidate
# generation: strip these off the end to produce a shorter slug candidate)
# and _DESCRIPTOR_STOPWORDS (scoring: ignore these words entirely on both
# sides of the token-overlap comparison, so a GOG title that adds a generic
# descriptor the Lutris name lacks isn't unfairly penalized for it).
_DESCRIPTOR_WORDS = (
    'game of the year', 'goty', 'definitive', 'enhanced', 'special',
    'deluxe', 'anniversary', 'ultimate', 'complete', 'extended',
    'remastered', 'redux', 'gold', 'remake', 'reboot', 'reimagined',
    'classic', 'unlimited',
)
_EDITION_SUFFIX_RE = re.compile(
    r'\s*[:\-]?\s*(?:' + '|'.join(_DESCRIPTOR_WORDS) + r')(?:\s+edition)?\s*$',
    re.IGNORECASE,
)
_DESCRIPTOR_STOPWORDS = {'edition'} | {
    w for phrase in _DESCRIPTOR_WORDS for w in phrase.split(' ')
}


def _tokenize(s):
    s = re.sub(r'[™®†‡©]', '', s.lower())
    tokens = set()
    for t in re.split(r'[^a-z0-9]+', s):
        if t and t not in _DESCRIPTOR_STOPWORDS:
            tokens.add(_ROMAN_TO_ARABIC.get(t, t))
    return tokens


def _match_score(input_title, candidate_name):
    """Token-overlap ratio (0.0-1.0) of candidate_name against input_title,
    relative to input_title's token count. See cmd_verify_slug_match for the
    threshold this is calibrated against."""
    input_tokens = _tokenize(input_title)
    candidate_tokens = _tokenize(candidate_name)
    if not input_tokens or not candidate_tokens:
        return 0.0
    overlap = input_tokens & candidate_tokens
    return len(overlap) / len(input_tokens)


def _url_to_filename(url):
    p = urllib.parse.urlparse(url)
    name = os.path.basename(urllib.parse.unquote(p.path))
    return name if name and '.' in name else 'resource_unknown'


def _resource_urls(installer):
    """Yield deeplink resource URLs referenced by one installer entry's
    script.files. Shared by cmd_extract_urls (network path, given a freshly
    fetched API response) and cmd_cache_check (local path, given a
    previously saved <slug>.json) so both agree on what a game's resource
    set is."""
    for f in installer.get('script', {}).get('files', []):
        if not isinstance(f, dict):
            continue
        for k, v in f.items():
            if isinstance(v, str) and v.startswith('http'):
                yield v
            elif isinstance(v, dict) and 'url' in v:
                yield v['url']


def cmd_url_to_filename():
    _require_argc(3)
    print(_url_to_filename(sys.argv[2]))


def cmd_product_title():
    """Read the 'title' field from a lgogdownloader product_*.json file.

    Defensive against three real-world failure modes:
      1. title is JSON null (d.get('title', '') returns None, not '')
      2. title is a non-string (rare, but lgogdownloader doesn't validate)
      3. file is not strict UTF-8 (BOM, Windows-1252 from old GOG metadata)

    Returns empty string instead of erroring when the file is structurally
    fine but the title field is unusable. Only hard-errors when the file
    itself cannot be read or parsed.
    """
    _require_argc(3)
    path = sys.argv[2]
    d = None
    try:
        # utf-8-sig handles UTF-8 with or without BOM transparently.
        with open(path, encoding='utf-8-sig') as f:
            d = json.load(f)
    except UnicodeDecodeError:
        # Last-resort fallback for files written by older tools on
        # non-UTF-8 locales. errors='replace' loses fidelity but keeps
        # us moving instead of aborting the whole detection phase.
        try:
            with open(path, encoding='utf-8', errors='replace') as f:
                d = json.load(f)
        except Exception as e:
            err('cannot decode ' + path + ': ' + str(e))
    except json.JSONDecodeError as e:
        err('invalid JSON in ' + path + ': ' + str(e))
    except Exception as e:
        err('cannot read ' + path + ': ' + str(e))

    if not isinstance(d, dict):
        err(path + ' does not contain a JSON object at top level')

    title = d.get('title')
    if title is None:
        # Field missing or explicitly null — emit empty, let the caller
        # decide what to do. Not an error.
        print('')
        return
    if not isinstance(title, str):
        title = str(title)
    print(title.strip())


def cmd_slug_candidates():
    """Generate slug candidates from least to most aggressive transformation.

    Two notes on Lutris slug conventions:

    1. Trademark symbols are inconsistent: some slugs strip ™/® entirely
       ('star-wars-jedi-knight'), others keep them as 'tm'/'r' inline
       ('star-warstm-rebel-assault-i-ii'). We emit both shapes per variant.

    2. The 'drop subtitle' transformation (everything after ':') is risky
       because 'Game: Subtitle' rarely collapses to 'game' on Lutris. It is
       kept as a late fallback only, and try_direct_slug() verifies the
       matched Lutris name to reject false positives (e.g. 'star-wars'
       swallowing 'Star Wars: Rebel Assault 1').
    """
    _require_argc(3)
    title = sys.argv[2].strip()

    def to_slug_strip(s):
        return re.sub(r'[^a-z0-9]+', '-', s.lower()).strip('-')

    def to_slug_keep_tm(s):
        s = s.lower().replace('\u2122', 'tm').replace('\u00ae', 'r')
        return re.sub(r'[^a-z0-9]+', '-', s).strip('-')

    variants = [
        title,                                                                       # full
        re.sub(r'\s*\(\d{4}\)\s*$', '', title).strip(),                              # drop (YYYY)
        re.sub(r'\s*\([^)]*\)\s*$', '', title).strip(),                              # drop (...)
        re.sub(r'\s*:\s*.*$', '', re.sub(r'[™®†‡]', '', title)).strip(),  # drop subtitle
        re.sub(r'\s+\d+\b', '', title).strip(),                                      # drop trailing digits
        re.sub(r'\s*:\s*.*$', '', re.sub(r'\s+\d+\b', '', title)).strip(),           # drop subtitle + digits
        _EDITION_SUFFIX_RE.sub('', title).strip(),                                   # drop edition suffix
        _EDITION_SUFFIX_RE.sub('', re.sub(r'[™®†‡©]', '', title)).strip(),           # drop edition suffix after tm/(r)
    ]

    # Derive extra variants per base variant: numerals swapped between roman
    # and arabic, and '&' spelled out as 'and' — both are places where GOG
    # titles and Lutris slugs commonly diverge (see docstring above).
    expanded = []
    for variant in variants:
        if not variant:
            continue
        expanded.append(variant)
        roman_swapped = _ROMAN_SLUG_PATTERN.sub(
            lambda m: _ROMAN_TO_ARABIC[m.group(1).lower()], variant)
        if roman_swapped != variant:
            expanded.append(roman_swapped)
        arabic_swapped = _ARABIC_SLUG_PATTERN.sub(
            lambda m: _ARABIC_TO_ROMAN[m.group(1)], variant)
        if arabic_swapped != variant:
            expanded.append(arabic_swapped)
        if '&' in variant:
            expanded.append(variant.replace('&', ' and '))
    variants = expanded

    seen = set()
    for variant in variants:
        if not variant:
            continue
        for slug in (to_slug_strip(variant), to_slug_keep_tm(variant)):
            if slug and slug not in seen:
                seen.add(slug)
                print(slug)


def cmd_search_names():
    _require_argc(3)
    title = sys.argv[2].strip()
    seen = []
    candidates = [
        title,
        re.sub(r'\s*\(\d{4}\)\s*$', '', title).strip(),
        re.sub(r'\s*\([^)]*\)\s*$', '', title).strip(),
    ]
    for n in candidates:
        if n and n not in seen:
            seen.append(n)
            print(n)


def cmd_has_game_id():
    """Boolean check: exit 0 if installer has an 'id' field, else exit 1.
    Errors during read also return exit 1 (treated as 'no'), but log to stderr."""
    _require_argc(3)
    try:
        with open(sys.argv[2]) as f:
            d = json.load(f)
        sys.exit(0 if d.get('id') else 1)
    except Exception as e:
        warn(str(e))
        sys.exit(1)


def cmd_url_encode():
    _require_argc(3)
    print(urllib.parse.quote(sys.argv[2]))


def cmd_extract_gog_id():
    """Replacement for grep -P. Extracts a 9-10 digit GOG ID surrounded by
    word boundaries or common separator characters."""
    _require_argc(3)
    filename = sys.argv[2]
    pattern = r'(?:^|[\[(\s_.\-])(\d{9,10})(?:[\])\s_.\-]|$)'
    m = re.search(pattern, filename)
    if m:
        print(m.group(1))


def cmd_find_slug_in_results():
    _require_argc(4)
    query = sys.argv[2].lower().strip()
    results_file = sys.argv[3]
    query_slug = re.sub(r'[^a-z0-9]+', '-', query).strip('-')
    query_noyear = re.sub(r'-\d{4}$', '', query_slug)
    query_noyear_name = re.sub(r'\s*\(\d{4}\)\s*$', '', query).strip()

    results = _load_json(results_file).get('results', [])

    if not results:
        sys.exit(1)

    checks = [
        lambda r: r.get('slug') == query_slug,
        lambda r: r.get('slug') == query_noyear,
        lambda r: r.get('name', '').lower().strip() == query,
        lambda r: r.get('name', '').lower().strip() == query_noyear_name,
        lambda r: r.get('slug', '').startswith(query_noyear),
    ]
    for check in checks:
        for r in results:
            if check(r):
                print(r['slug'])
                sys.exit(0)

    # None of the exact/prefix checks matched — an ambiguous search (e.g. a
    # generic query returning many unrelated results). Previously this fell
    # back to results[0] unconditionally, which silently picked whatever the
    # API ranked first, regardless of relevance. Score every candidate by
    # token overlap against the query instead, and only accept the best one
    # if it clears the same MATCH_THRESHOLD cmd_verify_slug_match uses — an
    # ambiguous search with no confident match is reported as 'not found'
    # rather than guessed.
    best_slug, best_score = '', 0.0
    for r in results:
        score = _match_score(query, r.get('name', ''))
        if score > best_score:
            best_slug, best_score = r.get('slug', ''), score
    if best_slug and best_score >= MATCH_THRESHOLD:
        print(best_slug)
        sys.exit(0)
    sys.exit(1)


def cmd_parse_installers():
    _require_argc(3)
    data = _load_json(sys.argv[2])

    for inst in data.get('installers', []):
        slug = inst.get('slug', '')
        runner = inst.get('runner', 'unknown')
        updated = (inst.get('updated_at') or inst.get('created_at') or '')[:10]
        status = 'published' if inst.get('published', False) else 'unpublished'
        if slug:
            print(slug + '\t' + runner + '\t' + updated + '\t' + status)


def cmd_extract_urls():
    _require_argc(4)
    target_slug = sys.argv[3]
    data = _load_json(sys.argv[2])

    inst = _find_installer_by_slug(data, target_slug)
    if inst is None:
        return
    for url in _resource_urls(inst):
        print(url)


def cmd_save_installer_json():
    _require_argc(5)
    target_slug = sys.argv[3]
    dest_dir = sys.argv[4]
    data = _load_json(sys.argv[2])

    inst = _find_installer_by_slug(data, target_slug)
    if inst is None:
        err('installer slug not found in API response: ' + target_slug)

    fname = re.sub(r'[^\w\-.]', '_', target_slug) + '.json'
    try:
        with open(os.path.join(dest_dir, fname), 'w') as f:
            json.dump(inst, f, indent=2, ensure_ascii=False)
    except Exception as e:
        err('cannot write JSON to ' + dest_dir + ': ' + str(e))


def cmd_save_installer_yaml():
    """Generate a fully-spec-compliant Lutris installer YAML.

    The Lutris API returns 'content' as the script body only (the part an
    author edits on the website). Lutris itself requires top-level fields
    (name, game_slug, version, slug, runner) per docs/installers.rst.
    Without them, the installer dialog displays 'game_slug' as a fallback
    title and refuses to install.

    We always overwrite top-level fields with API metadata (source of truth)
    and force string types to avoid YAML number coercion (Lutris issue #4365:
    a 'version: 012' line is parsed as octal 10 and locks the dialog).
    """
    _require_argc(5)
    try:
        import yaml
    except ImportError:
        err('python3-yaml not installed (required for YAML generation)')

    target_slug = sys.argv[3]
    dest_file = sys.argv[4]
    data = _load_json(sys.argv[2])

    inst = _find_installer_by_slug(data, target_slug)
    if inst is None:
        err('installer slug not found in API response: ' + target_slug)

    content = inst.get('content', '')
    try:
        parsed = yaml.safe_load(content) if content else {}
    except yaml.YAMLError as e:
        err('invalid YAML in API content: ' + str(e))

    # Heuristic: if the parsed content already exposes a 'script' key at
    # the top level, the API delivered a full document. Otherwise treat
    # the parsed content as the script body itself.
    if isinstance(parsed, dict) and 'script' in parsed:
        full = parsed
    else:
        full = {'script': parsed if isinstance(parsed, dict) else {}}

    # Required top-level fields per Lutris installer spec, plus 'version'
    # (not itself required, but always force-copied alongside the required
    # ones). Force string type to defeat YAML scalar inference.
    for field in REQUIRED_TOP_LEVEL_FIELDS + ('version',):
        value = inst.get(field)
        if value is not None:
            full[field] = str(value)

    # Optional but spec-compliant metadata, preserved if present.
    for field in ('description', 'notes', 'year', 'steamid', 'gogid',
                  'humbleid', 'humblestoreid', 'gogslug', 'installer_slug'):
        v = inst.get(field)
        if v not in (None, ''):
            full[field] = v

    # Sanity check: refuse to write a useless YAML.
    missing = [f for f in REQUIRED_TOP_LEVEL_FIELDS if not full.get(f)]
    if missing:
        err('installer ' + target_slug + ' missing required fields: '
            + ', '.join(missing))

    try:
        with open(dest_file, 'w') as f:
            yaml.dump(full, f, default_flow_style=False,
                      allow_unicode=True, sort_keys=False)
    except Exception as e:
        err('cannot write YAML to ' + dest_file + ': ' + str(e))


def cmd_verify_slug_match():
    """Verify that the matched Lutris game actually corresponds to our input
    title. Returns exit 0 if the token overlap is high enough, else exit 1.

    Why this exists:
      try_direct_slug() previously accepted any slug that returned HTTP 200
      with an 'id' field. That meant generic slugs like 'star-wars' would
      swallow specific titles like 'Star Wars: Rebel Assault 1', because
      cmd_slug_candidates emits 'star-wars' as a fallback variant.

    The heuristic:
      Tokens are extracted from both the GOG title and the Lutris game name
      (lowercased, trademark/copyright symbols stripped, split on non-alnum).
      Score = |overlap| / |input_tokens|.

    MATCH_THRESHOLD is calibrated against:
      - 'Star Wars Rebel Assault 1' vs 'Star Wars'    → 2/5 = 0.40 → reject
      - 'Star Wars Rebel Assault 1' vs 'Rebel Assault I & II' → 4/5 = 0.80 → accept
      - 'Half-Life 2' vs 'Half Life 2'                → 3/3 = 1.00 → accept
      - 'Pillars of Eternity II' vs 'Pillars of Eternity 2' → 3/4 = 0.75 → accept

    Known false-negative risk:
      Titles where GOG omits spaces but Lutris keeps them (or vice versa)
      tokenize differently. Roman-vs-Arabic numerals are normalized by
      _tokenize() (II == 2), single-letter numerals (I, V, X) included.
    """
    _require_argc(4)
    inst_file = sys.argv[2]
    input_title = sys.argv[3]
    data = _load_json(inst_file)

    installers = data.get('installers', [])
    if not installers:
        sys.exit(1)

    lutris_name = installers[0].get('name', '')
    if not lutris_name:
        sys.exit(1)

    score = _match_score(input_title, lutris_name)

    # Diagnostic line for the py_errors.log — useful when reading the report.
    print('verify slug=' + str(installers[0].get('game_slug', '?'))
          + ' score={:.2f}'.format(score)
          + ' input="' + input_title + '"'
          + ' lutris="' + lutris_name + '"', file=sys.stderr)

    if score >= MATCH_THRESHOLD:
        sys.exit(0)
    sys.exit(1)


