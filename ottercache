def cmd_cache_check():
    """Boolean check: exit 0 if all cached dirs exist and (unless
    no_resources) every deeplink resource referenced by each dir's own saved
    <slug>.json is present on disk too.

    Why the resource check matters: previously this only checked directory
    existence, so a game whose installer folder was created but lost a
    resource to a transient error (e.g. an HTTP 504 mid-run) looked
    permanently 'fully cached' -- process_game() would skip it, API calls
    and all, on every future run, and the only way to fetch the missing
    file was --force (which redownloads everything, not just what's
    missing). Reading the resource list from the *locally saved* JSON here
    (rather than the live API) keeps this check network-free.
    """
    _require_argc(5)
    try:
        data = _load_json(sys.argv[2])
        dirs = data.get(sys.argv[3], {}).get('dirs', [])
        outdir = sys.argv[4]
        no_resources = len(sys.argv) > 5 and sys.argv[5] == 'true'
        if not dirs:
            sys.exit(1)
        for d in dirs:
            inst_dir = os.path.join(outdir, d)
            if not os.path.isdir(inst_dir):
                sys.exit(1)
            if no_resources:
                continue
            for entry in os.scandir(inst_dir):
                if not entry.name.endswith('.json'):
                    continue
                try:
                    with open(entry.path) as jf:
                        inst = json.load(jf)
                except Exception:
                    continue
                for url in _resource_urls(inst):
                    if not os.path.exists(os.path.join(inst_dir, _url_to_filename(url))):
                        sys.exit(1)
        sys.exit(0)
    except SystemExit:
        raise
    except Exception as e:
        warn(str(e))
        sys.exit(1)


